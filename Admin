<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Admin — Migração de Canais</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Segoe UI',Tahoma,sans-serif;background:linear-gradient(135deg,#0d1b3e,#1a0d33,#2a0d2a);background-attachment:fixed;color:#fff;min-height:100vh;padding:30px;display:flex;justify-content:center;align-items:flex-start}
.box{max-width:820px;width:100%;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.12);border-radius:16px;padding:32px;box-shadow:0 20px 60px rgba(0,0,0,0.5)}
h1{color:#fdbb2d;font-size:1.5rem;margin-bottom:8px}
h2{color:#fdbb2d;font-size:1.1rem;margin:24px 0 12px}
.sub{opacity:.75;font-size:.9rem;line-height:1.55;margin-bottom:22px}
.user-line{background:rgba(255,255,255,0.05);padding:12px 16px;border-radius:10px;font-size:.9rem;margin-bottom:20px;border-left:3px solid #fdbb2d}
.user-line b{color:#fdbb2d}
.buttons{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:22px}
button{background:#fdbb2d;color:#000;border:none;padding:14px 24px;border-radius:10px;cursor:pointer;font-weight:bold;font-size:.95rem;transition:all .2s}
button:hover:not(:disabled){background:#ffcc44;transform:translateY(-1px)}
button:disabled{opacity:.45;cursor:not-allowed}
button.secondary{background:transparent;color:#fdbb2d;border:2px solid #fdbb2d}
button.secondary:hover:not(:disabled){background:rgba(253,187,45,0.15)}
#status{background:#0b1220;border:1px solid rgba(255,255,255,0.08);border-radius:10px;padding:20px;font-family:Consolas,monospace;font-size:13px;line-height:1.65;white-space:pre-wrap;max-height:500px;overflow-y:auto;display:none}
.ok{color:#2ecc71}
.err{color:#ef4444}
.info{color:#60a5fa}
.warn{color:#fbbf24}
.hl{color:#fdbb2d;font-weight:bold}
table{width:100%;border-collapse:collapse;margin-top:12px;font-family:'Segoe UI',sans-serif;font-size:13px}
th,td{text-align:left;padding:6px 10px;border-bottom:1px solid rgba(255,255,255,0.08)}
th{color:#fdbb2d;font-weight:bold}
</style>
</head>
<body>
<div class="box">
  <h1>Painel de Administração</h1>
  <p class="sub">Migração em lote dos canais de <b>todas as contas</b> da plataforma para o formato compatível com a página inicial.</p>

  <div class="user-line" id="userLine">Verificando autenticação...</div>

  <div class="buttons">
    <button class="secondary" id="btnDry" onclick="run(true)" disabled>Simular (dry-run)</button>
    <button id="btnRun" onclick="run(false)" disabled>Migrar todos os canais</button>
  </div>

  <div id="status"></div>
</div>

<script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-auth-compat.js"></script>
<script>
const firebaseConfig = {
  apiKey: "AIzaSyAfD0QOlAVb50612u6siwCxzfZfGmgEB2E",
  authDomain: "playtronic-tv.firebaseapp.com",
  projectId: "playtronic-tv"
};
if (!firebase.apps.length) firebase.initializeApp(firebaseConfig);
const auth = firebase.auth();

const statusEl = document.getElementById('status');
const userLine = document.getElementById('userLine');
const btnDry = document.getElementById('btnDry');
const btnRun = document.getElementById('btnRun');

function log(cls, msg){
  statusEl.style.display = 'block';
  const d = document.createElement('div');
  d.className = cls;
  d.textContent = msg;
  statusEl.appendChild(d);
  statusEl.scrollTop = statusEl.scrollHeight;
}
function clearLog(){ statusEl.innerHTML = ''; }

auth.onAuthStateChanged(user => {
  if (!user) {
    userLine.innerHTML = '<span class="err">Você não está logado.</span> Faça login no gerador primeiro.';
    btnDry.disabled = true;
    btnRun.disabled = true;
    return;
  }
  userLine.innerHTML = 'Logado como <b>' + (user.email || user.uid) + '</b> &middot; UID: <b>' + user.uid + '</b>';
  btnDry.disabled = false;
  btnRun.disabled = false;
});

async function run(dryRun){
  btnDry.disabled = true;
  btnRun.disabled = true;
  clearLog();

  log('info', '══════════════════════════════════════');
  log('info', (dryRun ? 'MODO SIMULAÇÃO (dry-run)' : 'MODO REAL — vai alterar o banco'));
  log('info', '══════════════════════════════════════');
  log('info', 'Chamando Cloud Function...');
  log('info', '');

  try {
    const user = auth.currentUser;
    if (!user) throw new Error('Não autenticado');
    const idToken = await user.getIdToken(true);

    const resp = await fetch('https://us-central1-playtronic-tv.cloudfunctions.net/adminMigrateAllChannels', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': 'Bearer ' + idToken
      },
      body: JSON.stringify({ dryRun: dryRun })
    });

    const data = await resp.json().catch(() => null);

    if (!resp.ok || !data || !data.success) {
      throw new Error((data && data.error) || ('HTTP ' + resp.status));
    }

    const s = data.stats || {};
    log('ok', '');
    log('ok', '✓ CONCLUÍDO');
    log('ok', '─────────────────────────────────────');
    log('ok', 'Contas percorridas:  ' + (s.totalUsers || 0));
    log('ok', 'Canais encontrados:  ' + (s.totalChannels || 0));
    log('ok', '  · Ativos (no ar):  ' + (s.totalActive || 0));
    log('ok', '  · Offline:         ' + (s.totalOffline || 0));
    log('ok', '');
    log('hl', 'RESULTADO DA MIGRAÇÃO:');
    log('hl', '  · Docs criados:      ' + (s.created || 0));
    log('hl', '  · Docs atualizados:  ' + (s.updated || 0));
    log('hl', '  · Já estavam OK:     ' + (s.skipped || 0));

    if (s.errors && s.errors.length > 0) {
      log('warn', '');
      log('warn', '⚠ Erros (' + s.errors.length + '):');
      s.errors.slice(0, 30).forEach(e => log('err', '  · ' + e));
    }

    if (data.detalhes && data.detalhes.length > 0) {
      log('info', '');
      log('info', 'Amostra de canais encontrados (' + data.detalhes.length + ' no total):');
      // Mostra os 30 primeiros
      data.detalhes.slice(0, 30).forEach(d => {
        log('info', '  ' + d.channelId + ' | ' + d.name + ' | owner=' + d.ownerId.substring(0,8) + '… | ' + (d.isOffline ? 'OFFLINE' : 'ativo'));
      });
      if (data.detalhes.length > 30) {
        log('info', '  ... e mais ' + (data.detalhes.length - 30) + ' canais');
      }
    }

    log('info', '');
    if (dryRun) {
      log('info', 'Nada foi alterado. Clique em "Migrar todos os canais" para aplicar.');
    } else {
      log('ok', 'Migração aplicada. Abra a página inicial em nova aba para ver todos os canais.');
    }

  } catch(e){
    log('err', '');
    log('err', 'ERRO: ' + e.message);
    if (String(e.message).indexOf('sem permissao') !== -1) {
      log('warn', 'Seu UID não está na lista ADMIN_UIDS da Cloud Function.');
      log('warn', 'Seu UID é: ' + (auth.currentUser ? auth.currentUser.uid : '?'));
      log('warn', 'Cole ele na lista dentro de functions/index.js e faça deploy de novo.');
    }
  } finally {
    btnDry.disabled = false;
    btnRun.disabled = false;
  }
}
</script>
</body>
</html>
